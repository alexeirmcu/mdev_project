{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "" 
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": ""
  },
  "OpenMeteoApi": {
    "BaseUrl": "https://api.open-meteo.com/",
    "TimeoutSeconds": 5
  },
  "FoursquareApi": {
    "BaseUrl": "https://places-api.foursquare.com/",
    "ApiVersion": "2025-06-17",
    "ApiKey": ""
  },
  "LlmApi": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "Model": "gemini-2.5-flash-lite",
    "ApiKey": ""
  },
  "LlmEnrichment": {
    "UseFoursquarePremiumFields": false,
    "MaxRetries": 3,
    "PollingIntervalSeconds": 30,
    "LeaseTimeoutSeconds": 300,
    "BatchSize": 10
  },
    "PromptTemplates": {
      "PlaceEnrichment": {
        "SystemPrompt": "You are a place metadata assistant. Respond ONLY with valid JSON.",
        "UserPromptTemplate": "Place: {{Name}}\n{{CategoriesSection}}{{OpeningHoursSection}}{{VisitorTipsSection}}\n\nRespond with valid JSON only in this exact schema:\n{{Schema}}",
        "Temperature": 0.1
      }
    }
}
